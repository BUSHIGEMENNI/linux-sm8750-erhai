# SPDX-License-Identifier: GPL-2.0-only
# SM8750 platform build and RAM diagnostics, not an erhai board definition.
# Merge on top of arm64 defconfig. VEXPRESS retains QEMU virt smoke coverage.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_VEXPRESS=y
CONFIG_LOCALVERSION="-erhai-dev"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ROLE_SWITCH=y
# Removable storage uses upstream drivers loaded by the desktop's udev/udisks.
# Keep these optional protocols and filesystems out of the early boot image.
CONFIG_USB_UAS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
# NTFS3 uses the default NLS when desktop mounts omit iocharset.
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_UTF8=y
# Legacy USB tethering devices which do not offer CDC Ethernet/NCM.
CONFIG_USB_NET_RNDIS_HOST=m
# Common USB UART adapters use the upstream usb-serial stack.
CONFIG_USB_SERIAL_CH341=m
# Standard HID peripheral batteries are consumed through power_supply/UPower.
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_PHY_QCOM_M31_EUSB=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_TYPEC=y
CONFIG_SM_GCC_8750=y
CONFIG_SM_TCSRCC_8750=y
CONFIG_PINCTRL_SM8750=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_RPMHPD=y
CONFIG_INTERCONNECT_QCOM_SM8750=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Display chain: DPU/DSI, panel and external backlight, all built-in
# QCOM_LLCC/OCMEM must be built-in or DRM_MSM is limited to =m
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_DRM_MSM=y
CONFIG_SM_DISPCC_8750=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_DRM_PANEL_NOVATEK_NT36536=y
# Touch: NT36536 SPI TDDI behind spi4 (QUPv3 SE4), built-in like the panel
CONFIG_SPI_QCOM_GENI=y
# geni SPI needs the QUP GPI DMA engine at probe time; built-in, not a module
CONFIG_QCOM_GPI_DMA=y
CONFIG_TOUCHSCREEN_NT36536_SPI=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_KTZ8866=y
# Both KTZ8868 LED strings form the panel backlight through led-backlight
CONFIG_BACKLIGHT_LED=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
# Kernel log over the USB NCM debug link: the gadget interface only exists
# once user space has configured it, so targets are created at runtime
# through configfs rather than on the command line
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
# ADSP remoteproc (pmic-glink transport, later audio), built-in for the module-less initramfs
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
# sysmon QMI needs the QRTR core built in; =m leaves it absent in the initramfs
# and qmi_handle_init fails the PAS probe in a defer loop
CONFIG_QRTR=y
# QRTR reaches the DSPs through the IPCRTR rpmsg channel served by the
# (historically named) SMD transport; =m cuts all servreg/sysmon traffic
CONFIG_QRTR_SMD=y
# Type-C role/orientation events ride the ADSP glink channel; built-in so USB
# host/device role switching works from the initramfs rig as well
CONFIG_QCOM_PMIC_GLINK=y
# the connector port is registered by ucsi_glink (aux device of pmic-glink);
# the whole chain must be built in, =m pieces are absent in the initramfs
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y
# in-kernel protection-domain mapper: resolves the UCSI/charger services the
# ADSP advertises; =m leaves pmic-glink clients waiting forever
CONFIG_QCOM_PD_MAPPER=y
# The battery and charger live on the ADSP and are driven over the same glink
# transport.  2026-10-24: qcom_battmgr is REPLACED by the erhai charging stack
# ported from the 7.3-rc5 tree (lab-validated 39 W PPS): erhai_otg_glink binds
# the pmic_glink.power-supply aux device FIRST and would lock battmgr out (or
# race it), so battmgr must stay off.  psy names change: battmgr-* ->
# erhai-adsp-bat / erhai-adsp-usb.
CONFIG_BATTERY_QCOM_BATTMGR=n
# erhai fast-charge stack (erhai_pps 39 W PPS engine + SC8547A dual pump).
# erhai_otg_glink must be built-in like battmgr was (initramfs has no modules);
# it also handles the OPLUS OTG notifications (0x50/0x51) battmgr used to.
CONFIG_ERHAI_OTG_GLINK=y
CONFIG_CHARGER_ERHAI_PPS=y
CONFIG_CHARGER_SC8547A=m
# The WCD939x USB-C switch routes the SBU pins to the DisplayPort AUX lines.
# Once it is in the connector graph, pmic_glink_altmode, the DisplayPort
# bridge chain and with it the whole MDSS (panel included) wait for it; =m
# would hold the display until the root filesystem can load it.
CONFIG_TYPEC_MUX_WCD939X_USBSS=y
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_KVM is not set
# CONFIG_KUNIT is not set
# CONFIG_WERROR is not set

# The boot partition on this device is GKI v4: the bootloader hands the kernel
# a bootconfig section appended after the ramdisk instead of putting everything
# on the command line. Without this the kernel would take those trailing bytes
# for part of the initramfs.
CONFIG_BOOT_CONFIG=y

# RAM-rooted desktop demo: fetch a zstd squashfs over the NCM link and mount
# it with a writable overlay; both must be built in for the initramfs rig.
# The installed system needs the rest of squashfs too: Ubuntu's casper layers
# are xz and carry xattrs, and its snaps are xz/lzo images that systemd mounts
# under /snap at every boot. Without xattr support file capabilities would be
# dropped silently on anything read through squashfs.
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y

# ACM serves the attended console ramdisk; NCM is the unattended evidence channel.
# CONFIG_USB_CONFIGFS_SERIAL is not set
# CONFIG_USB_CONFIGFS_OBEX is not set
CONFIG_USB_CONFIGFS_NCM=y
# CONFIG_USB_CONFIGFS_ECM is not set
# CONFIG_USB_CONFIGFS_ECM_SUBSET is not set
# CONFIG_USB_CONFIGFS_RNDIS is not set
# CONFIG_USB_CONFIGFS_EEM is not set
# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
# CONFIG_USB_CONFIGFS_F_FS is not set

# Adreno 830: the GPU clock controller must be built in; the initramfs
# has no module loader so a =m gpucc strands the whole GPU chain.
CONFIG_SM_GPUCC_8750=y

# WCN7860 WLAN on pcie0: built-in because the RAM desktop chain carries no
# module tree; BT stays modular until the HCI UART is wired up.
CONFIG_ATH12K=m
CONFIG_PCI_PWRCTRL_PWRSEQ=m
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH12K=m
# RFKILL=m caps CFG80211 (depends on RFKILL || !RFKILL) at =m.
CONFIG_RFKILL=y

# The WCN7860 is self-managed and starts in the world domain (00), whose 5 GHz
# rules allow client connections but no access point. Let user space pass the
# country the tablet is in; the device packages do not set one, so the tablet
# stays in the world domain unless a user does.
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_ATH_REG_DYNAMIC_USER_REG_HINTS=y

# PCIe PHY for the WCN7860 link; =m leaves pcie0 deferred forever.
CONFIG_PHY_QCOM_QMP_PCIE=y

# qcom-pon creates the pwrkey/resin child devices; =m with no module tree
# leaves the power/volume keys unregistered (liuqin S2-11).
CONFIG_POWER_RESET_QCOM_PON=y

# Bluetooth (WCN7860) over uart14 serdev; the RAM desktop has no module tree.
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
# The controller alone only scans. What the desktop connects over it needs:
# LE (defconfig turns it off): LE links to keyboards and mice, and the ISO
# socket that LE Audio uses. Default-on LE L2CAP ECRED comes with it.
CONFIG_BT_LE=y
# RFCOMM: HFP/HSP signalling and serial port profile.
# BT debugfs: exposes /sys/kernel/debug/bluetooth/hci0/{supervision_timeout,
# conn_min_interval,...}.  The kernel default LE supervision timeout is
# 420ms (0x2a); this controller needs ~600ms to complete LE Start
# Encryption, so every encrypted connection dies with "Connection Timeout"
# at the exact moment encryption finishes.  erhai-bt-tune.service raises it
# to 4s at boot.  Without this knob the only lever is a kernel rebuild.
CONFIG_BT_DEBUGFS=y
CONFIG_BT_RFCOMM=m
# The three below are bool symbols, so "=m" is rejected by kconfig and they
# silently fall back to n — a bool sub-option of a tristate parent is still
# y-or-n, and y means "built into rfcomm.ko/bnep.ko".
CONFIG_BT_RFCOMM_TTY=y
# BNEP: Bluetooth network tethering (PAN).
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
# uhid: BlueZ runs HID over GATT (LE keyboards and mice) through /dev/uhid,
# and classic HID too when UserspaceHID is set. Built in like the rest of
# the input path, so a keyboard works before any module could be loaded.
CONFIG_UHID=y

# reboot-mode: the erhai DTB carries a `reboot-mode { compatible =
# "nvmem-reboot-mode"; mode-bootloader = <0x02>; }` node backed by a PMIC SDAM
# cell, which is how this bootloader is told to stop in fastboot. As a module
# it is never loaded -- neither the initramfs nor the installed root carries a
# module tree for this kernel -- so `reboot bootloader` from Linux came back up
# in Linux, and every experiment that writes the boot slot had to be recovered
# from the host instead. Built in, Linux can hand the device back to fastboot
# on its own. A plain reboot still writes nothing: the node declares no
# mode-normal, so the notifier finds no magic and skips the nvmem write.
CONFIG_NVMEM_REBOOT_MODE=y

# ... and its nvmem supplier. The cell the reboot-mode node writes lives in a
# PMIC SDAM, and with the SDAM driver modular the reboot-mode platform device
# sat in deferred probe forever: "wait for supplier
# /soc@0/spmi@c400000/pmic@0/nvram@7100/reboot-reason@48" (measured on the
# tablet, 2026-09-21, with NVMEM_REBOOT_MODE already built in). A built-in
# consumer whose provider is a module it cannot load is no better than the
# module it replaced.
CONFIG_NVMEM_SPMI_SDAM=y

# Wall clock. The PMIC carries an RTC ("qcom,pmk8350-rtc" at 0x6100 in this
# board's pmk8550), but RTC_DRV_PM8XXX was =m and this kernel ships no module
# tree, so Ubuntu came up with no /dev/rtc0 at all: the system clock started
# at whatever the root filesystem was built with (measured on the tablet,
# 2026-09-21: 2026-04-15, 159 days behind), every file got that date and apt
# had to be told -o Acquire::Check-Valid-Until=false to accept a Release file
# from its own future. Built in, the RTC is there before userspace is, and
# RTC_HCTOSYS (already set) seeds the system clock from it at registration.
CONFIG_RTC_DRV_PM8XXX=y

# Board thermistors use the PMK8550 SDAM interface and standard IIO channels.
CONFIG_QCOM_SPMI_ADC5_GEN3=m
# Threshold monitoring on those channels registers them as thermal zones; it is
# an auxiliary driver of the ADC above and loads with it.
CONFIG_QCOM_SPMI_ADC_TM5_GEN3=m

# Amplifier support is staged before the board audio routes are enabled.
CONFIG_SND_SOC_AW88261=m

# Ubuntu's ALSA module loader requires snd-seq when loading snd. Without it,
# the distribution's install hook fails before dependent codec modules load.
CONFIG_SND_SEQUENCER=m

# The idle blank and its wake path can only be proved from the debug channel by
# feeding the seat a real input event: mutter wakes the screen on input, not on
# a D-Bus poke, so without an injectable device the "does a key press bring the
# desktop back" half of the test can only be answered by a person in the room.
# uinput is what every desktop already uses for that (accessibility tools,
# remote input, automation), and this kernel ships no module tree.
CONFIG_INPUT_UINPUT=y

# Suspend works on this tablet, and these are what let anybody say so.
# pm_test asks the machine to suspend every device and resume immediately
# without entering the low-power state, which is the one suspend experiment
# that cannot end the session, and pm_debug_messages is what makes a failed
# attempt name the device that failed instead of just stopping. Both cost
# nothing while nothing asks for them, and this is a port where the next
# driver to gain a suspend callback is the next one to get it wrong.
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y

# A suspend that hangs in a driver's callback leaves the tablet with no
# debug channel and no timer that can run: user space is frozen, and the
# Gunyah watchdog stops across system sleep by design. The device
# suspend/resume watchdog turns such a hang into a panic that names the
# device and prints the stuck task, and panic= on the command line turns
# the panic into a reboot. The warning comes first: ath12k alone may wait
# 20 s for its firmware on resume. The option is only offered under EXPERT;
# that also makes RESET_SIMPLE selectable, whose default would build a
# reset driver this SoC does not use, so it is kept off as before.
CONFIG_EXPERT=y
CONFIG_DPM_WATCHDOG=y
CONFIG_DPM_WATCHDOG_TIMEOUT=60
CONFIG_DPM_WATCHDOG_WARNING_TIMEOUT=30
# CONFIG_RESET_SIMPLE is not set

# The same kind of hang outside system sleep: the hung task check reports a
# task stuck in uninterruptible sleep for 120 s, and the soft lockup check a
# CPU that runs kernel code for 20 s without scheduling, each with a stack
# trace. Neither panics by default, so an ordinary boot only logs the
# report. A debug session can turn a report into a panic with
# kernel.hung_task_panic and kernel.softlockup_panic, or the boot parameters
# of the same names, and panic= then reboots: a driver that hangs while the
# system shuts down otherwise keeps the tablet on until the power key is
# held. The buddy hard lockup detector is not enabled: without pseudo-NMI it
# can name a CPU spinning with interrupts disabled but not show where, and
# the tasks that wait for that CPU reach the hung task check anyway.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# The keyboard cover on the pogo pin connector. A module, like the other
# optional devices: nothing before the root filesystem needs it.
CONFIG_KEYBOARD_ONEPLUS_POGO=m

# The watchdog: Linux runs as a Gunyah guest here, the stock devicetree gives
# the HLOS no MMIO watchdog node, and the vendor kernel pets the hypervisor's
# virtual watchdog instead. qcom_scm registers the upstream gunyah-wdt device
# when it finds Gunyah and no MMIO watchdog node, so no devicetree change is
# needed. Built in: the RAM boot initramfs carries no modules, and the
# watchdog has to be usable before the root filesystem is. The sysfs view
# lets its state and time left be read without opening, and so arming, it.
CONFIG_GUNYAH_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y

# Wireless pen charger (CPS8601) on i2c_hub_3, reverse-engineered driver
CONFIG_CHARGER_CPS8601=m

# erhai_pps charge-pump tracepoints (echo 1 > .../events/erhai_pps/enable):
# the tree default has FTRACE off; these three make the c0 trace usable
CONFIG_FTRACE=y
CONFIG_TRACING=y
CONFIG_TRACEPOINTS=y

# --- desktop-agent merge 2026-10-24 ---
# initramfs 固件竞态根治（与 ath12k/bt/touch =m 配套；设备固件为 zst 压缩，必须能解压）
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# 安卓兼容层（Waydroid/Droidloom 前置，GAP-deniwm.md §2.1）
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# Waydroid 推荐 PSI
CONFIG_PSI=y
# Waydroid 硬要求：set_sched_policy 走 /dev/cpuctl（system_server 没它必崩，
# tombstone: "failed to set background scheduling policy" / Zygote.cpp:726 EPERM）
CONFIG_RT_GROUP_SCHED=y
# 相机应用（Snapshot 等沙箱 GUI）取流需要 dma-buf 分配器；没有它 libcamera 在
# 沙箱里 DmaBufAllocator 全开失败 → GUI 显示"无相机"，而命令行工具能降级 malloc
CONFIG_UDMABUF=y
# Camera buffers go through the DMA-BUF CMA heap: one 4152x3120 ABGR frame
# is 49.4 MB and the matching RAW10 buffer 15.5 MB, so libcamera's usual
# four buffers per stream need ~260 MB for the rear camera alone.  The
# arm64 defconfig default (32 MB, plus the 12 MB ADSP rpc pool = 44 MB)
# cannot hold even one frame -- libcamera fails with "dma-heap allocation
# failure" and the rear camera never starts.  320 MB covers that with
# ~60 MB to spare.
#
# 320 is not arbitrary, and going higher silently destroys the pool: the
# DT dma-ranges pins arm64_dma_phys_limit at 4 GiB, and dma_contiguous_
# reserve() only ever asks for ONE contiguous range below that limit (the
# multi-range cma_declare_contiguous_multi() is not on this path).  Below
# 4 GiB the boot memory map (measured, g70a2c623dd56) has exactly one clean
# hole: 0xbe360000-0xd4e23000 = 362.8 MiB -- the kernel image sits at
# 0xa8000000 splitting the other big range, and 0xef800000-0xf37fffff is
# reserved.  A 512 MB request cannot fit anywhere, so the kernel prints
# "cma: Failed to reserve 512 MiB" and boots with NO default pool at all
# (only the 12 MB DT adsp-rpc-remote-heap survives) -- strictly worse than
# the 44 MB we started from.  320 MiB deterministically lands top-down at
# 0xc0e00000 with 42 MiB of slack under it.  verify-after-reboot.sh gates
# on CmaTotal so this can never regress silently again.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=320
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# AppArmor: Ubuntu ships apparmor and snapd by default and their tooling
# reports "cannot check apparmor kernel features" on every snap start
# without it.  SECURITY_PATH and SECURITY_NETWORK are its hard prerequisites
# and are off in arm64 defconfig.
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,bpf,apparmor"

# 前摄传感器（QUP SE9 I2C，寄存器表来自 caihong 同源实证 56a6e662e）
CONFIG_VIDEO_SC820CS=m
# 后摄 SC1320CS + CN3927 对焦马达（CCI0-m1，驱动来自 TheMojoMan 树）
CONFIG_VIDEO_SC1320CS=m
CONFIG_VIDEO_CN3927=m

# Bluetooth: WCN7860 support lives in this tree's hci_qca.c (peri_set_baudrate
# private handshake included). Pin the serdev driver to =y: as a module it has
# been silently dropped by defconfig merges before. Firmware ships .zst only.
CONFIG_BT_HCIUART_QCA=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Waydroid networking: LXC container needs iptables NAT/masquerade.
# IPTABLES=m alone is a shell without FILTER/NAT; enable the family.
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_VETH=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
# Android's netd drives iptables (legacy tables) for its own chains and
# exits 1 without them; with PREEMPT_RT off the legacy xtables core is
# available, and several match/target modules it always asks for were
# missing from this fragment.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
# netd's own chain set (see the bw_* tables in its restore scripts) uses
# these; each was absent from the fragment and each one costs a whole
# iptables-restore failure:
#   - "filter" table: iptable_filter itself, plus -m bpf/-j REJECT in the
#     bandwidth chains and -m state in the legacy per-uid chains;
#   - "raw" table: the bw_raw_PREROUTING chain netd rebuilds every boot.
# NETFILTER_XT_MATCH_POLICY and NETFILTER_XT_TARGET_CT only exist when
# their dependencies are on, and both dependencies were off:
#   - POLICY needs XFRM, which XFRM_USER selects (otherwise the symbol is
#     silently dropped and `-m policy` fails every mangle restore);
#   - CT needs NF_CONNTRACK *and* one of IP_NF_RAW / IP6_NF_RAW / NFT_COMPAT.
# netd's XfrmController also needs the NETLINK_XFRM socket, i.e. XFRM_USER.
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_MATCH_POLICY=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_HL=m
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=m
CONFIG_XFRM_USER=m
CONFIG_NET_KEY=m
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_NETLINK_LOG=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NF_CT_NETLINK=m
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_INET_UDP_DIAG=m
CONFIG_UNIX_DIAG=m
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
# The "netdev" family and its forward expression, not NFT_FWD_META (no such
# symbol exists; merge_config.sh silently drops unknown names, so the old
# line bought nothing).
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_FWD_NETDEV=m

# zswap: compressed swap cache in front of the 8G swapfile.  Built-in default-on
# so it survives every boot with no tuning.  Compressor LZ4: CRYPTO_LZ4 is =y in
# the base config; CRYPTO_ZSTD is =m and a module-backed default would break the
# first swap-on at boot.  Pool is zsmalloc (this tree has no zbud/z3fold choice).
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
