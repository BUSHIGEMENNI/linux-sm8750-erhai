/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include <dt-bindings/thermal/thermal.h>
#include "sm8750.dtsi"
#include "pm8550.dtsi"
#define PMK8550VE_SID 8
#include "pm8550ve.dtsi"
#include "pmih0108.dtsi"
#include "pmk8550.dtsi"
#include "sm8750-pmics.dtsi"

/ {
	model = "OnePlus Pad 2 Pro";
	compatible = "oneplus,erhai", "qcom,sm8750";
	chassis-type = "tablet";

	aliases {
		serial0 = &uart7;
	};

	/*
	 * Both KTZ8868 chips light the one panel and always get the same
	 * brightness value. The initial level is the stock default brightness
	 * level 913 mapped through the stock kernel's backlight table.
	 */
	panel_backlight: backlight {
		compatible = "led-backlight";
		leds = <&ktz8868_master_led>, <&ktz8868_slave_led>;
		default-brightness-level = <1433>;
	};

	sound {
		compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
		model = "OnePlus-Pad-2-Pro";
		audio-routing = "IN1_HPHL", "HPHL_OUT",
				"IN2_HPHR", "HPHR_OUT",
				"AMIC1", "MIC BIAS1",
				"AMIC2", "MIC BIAS2",
				"AMIC3", "MIC BIAS4",
				"AMIC4", "MIC BIAS3",
				"AMIC5", "MIC BIAS3",
				"TX SWR_INPUT0", "ADC1_OUTPUT",
				"TX SWR_INPUT1", "ADC2_OUTPUT",
				"TX SWR_INPUT2", "ADC3_OUTPUT",
				"TX SWR_INPUT3", "ADC4_OUTPUT";

		pinctrl-0 = <&sec_tdm_active>;
		pinctrl-names = "default";

		displayport-0-dai-link {
			link-name = "DisplayPort0 Playback";
			convert-sample-format = "s24_le";

			cpu {
				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
			};

			codec {
				sound-dai = <&mdss_dp0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		/* USB-C analog headphones via WCD9395 HPH + usbss SBU switch */
		wcd-playback-dai-link {
			link-name = "WCD Playback";

			cpu {
				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
			};

			codec {
				sound-dai = <&wcd939x 0>, <&swr1 0>, <&lpass_rxmacro 0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			cpu {
				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
			};

			codec {
				sound-dai = <&wcd939x 1>, <&swr2 1>, <&lpass_txmacro 0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		/*
		 * Secondary TDM at 48 kHz: eight 32-bit slots, DSP_B framing,
		 * clocks from the SoC. Each amplifier takes the slot equal to
		 * its stock channel index and latches data on the inverted bit
		 * clock edge, as the stock amplifier configuration does.
		 */
		speaker-playback-dai-link {
			link-name = "Speaker Playback";
			dai-format = "dsp_b";
			convert-rate = <48000>;
			convert-channels = <8>;
			convert-sample-format = "s32_le";

			cpu {
				sound-dai = <&q6apmbedai SECONDARY_TDM_RX_0>;
				dai-tdm-slot-num = <8>;
				dai-tdm-slot-width = <32>;
				dai-tdm-slot-rx-mask = <1 1 1 1 1 1 1 1>;
			};

			codec-0 {
				sound-dai = <&spk_amp0>;
				dai-tdm-slot-tx-mask = <1>;
				dai-tdm-slot-rx-mask = <1>;
				bitclock-inversion;
			};

			codec-1 {
				sound-dai = <&spk_amp1>;
				dai-tdm-slot-tx-mask = <0 1>;
				dai-tdm-slot-rx-mask = <0 1>;
				bitclock-inversion;
			};

			codec-2 {
				sound-dai = <&spk_amp2>;
				dai-tdm-slot-tx-mask = <0 0 1>;
				dai-tdm-slot-rx-mask = <0 0 1>;
				bitclock-inversion;
			};

			codec-3 {
				sound-dai = <&spk_amp3>;
				dai-tdm-slot-tx-mask = <0 0 0 1>;
				dai-tdm-slot-rx-mask = <0 0 0 1>;
				bitclock-inversion;
			};

			codec-5 {
				sound-dai = <&spk_amp5>;
				dai-tdm-slot-tx-mask = <0 0 0 0 0 1>;
				dai-tdm-slot-rx-mask = <0 0 0 0 0 1>;
				bitclock-inversion;
			};

			codec-6 {
				sound-dai = <&spk_amp6>;
				dai-tdm-slot-tx-mask = <0 0 0 0 0 0 1>;
				dai-tdm-slot-rx-mask = <0 0 0 0 0 0 1>;
				bitclock-inversion;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};
	};

	wcd939x: audio-codec {
		compatible = "qcom,wcd9390-codec";
		#sound-dai-cells = <1>;

		pinctrl-0 = <&wcd_reset_default>;
		pinctrl-names = "default";
		reset-gpios = <&tlmm 101 GPIO_ACTIVE_LOW>;

		vdd-buck-supply = <&vreg_l15b_1p8>;
		vdd-rxtx-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l15b_1p8>;
		vdd-mic-bias-supply = <&vreg_bob1>;
		vdd-px-supply = <&vreg_l2i_1p2>;

		qcom,micbias1-microvolt = <2700000>;
		qcom,micbias2-microvolt = <2700000>;
		qcom,micbias3-microvolt = <2700000>;
		qcom,micbias4-microvolt = <2700000>;
		qcom,rx-device = <&wcd_rx>;
		qcom,tx-device = <&wcd_tx>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	clocks {
		xo_board: xo-board {
			compatible = "fixed-clock";
			clock-frequency = <76800000>;
			#clock-cells = <0>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};

		bi_tcxo_div2: bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;

			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-mult = <1>;
			clock-div = <2>;
		};

		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;

			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
			clock-mult = <1>;
			clock-div = <2>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&volume_down_n>;
		pinctrl-names = "default";

		key-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};

	pmic-glink {
		compatible = "oneplus,pad2pro-pmic-glink",
			     "qcom,sm8750-pmic-glink",
			     "qcom,sm8550-pmic-glink",
			     "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0>;

			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&usb_dwc3_hs>;
					};
				};

				port@1 {
					reg = <1>;

					pmic_glink_ss_in: endpoint {
						remote-endpoint = <&usb_dp_qmpphy_out>;
					};
				};

				port@2 {
					reg = <2>;

					pmic_glink_sbu: endpoint {
						remote-endpoint = <&wcd_usbss_sbu_mux>;
					};
				};
			};
		};
	};

	/*
	 * Switched supply of the keyboard pogo pin connector. The keyboard
	 * driver keeps it off until the attach sense line reports a keyboard.
	 */
	pogo_kb_pwr: regulator-pogo-kb-pwr {
		compatible = "regulator-fixed";
		regulator-name = "pogo_kb_pwr";
		gpio = <&tlmm 85 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * Placeholder for the DVDD input of the six AW88261 amplifiers. The
	 * stock DT gives the amplifiers no supply and its driver requests none;
	 * their chip IDs read back on both stock and mainline without any
	 * consumer holding a rail, which suggests DVDD is up whenever the SoC
	 * runs. Which PMIC output feeds it is unknown, so no voltage, parent
	 * supply or control is described here. Replace this node with that
	 * output once it is identified.
	 */
	spk_amp_dvdd: regulator-spk-amp-dvdd {
		compatible = "regulator-fixed";
		regulator-name = "spk_amp_dvdd";
		regulator-always-on;
		regulator-boot-on;
	};

	thermal-zones {
		/*
		 * The stock tree pauses a CPU core when one of its two sensors
		 * reaches 118 C and takes the core offline at 120 C (C.34
		 * vendor_boot DTB for SM8750P, cpu-*-* zones). Mainline has no
		 * pause or hotplug cooling devices, so a passive trip at the first
		 * of these temperatures throttles the frequency domain of the core
		 * instead; the zones keep their 120 C hot and 125 C critical trips.
		 */
		cpu-0-0-0-thermal {
			polling-delay-passive = <250>;

			trips {
				cpu_0_0_0_alert: trip-point1 {
					temperature = <118000>;
					hysteresis = <8000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_0_0_0_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-0-0-1-thermal {
			polling-delay-passive = <250>;

			trips {
				cpu_0_0_1_alert: trip-point1 {
					temperature = <118000>;
					hysteresis = <8000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_0_0_1_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-0-1-0-thermal {
