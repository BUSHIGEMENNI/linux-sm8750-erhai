		qcom,pmic-id = "i";

		vreg_s7i_1p2: smps7 {
			regulator-name = "vreg_s7i_1p2";
			regulator-min-microvolt = <1224000>;
			regulator-max-microvolt = <1340000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s8i_0p9: smps8 {
			regulator-name = "vreg_s8i_0p9";
			regulator-min-microvolt = <900000>;
			regulator-max-microvolt = <972000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1i_1p2: ldo1 {
			regulator-name = "vreg_l1i_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2i_1p2: ldo2 {
			regulator-name = "vreg_l2i_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3i_0p88: ldo3 {
			regulator-name = "vreg_l3i_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <912000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-5 {
		compatible = "qcom,pm8550vs-rpmh-regulators";

		vdd-l1-supply = <&vreg_s1d_0p97>;
		vdd-l2-supply = <&vreg_s7i_1p2>;
		vdd-s2-supply = <&vph_pwr>;
		vdd-s3-supply = <&vph_pwr>;
		vdd-s4-supply = <&vph_pwr>;

		qcom,pmic-id = "j";

		vreg_s2j_1p1: smps2 {
			regulator-name = "vreg_s2j_1p1";
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1100000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s3j_1p1: smps3 {
			regulator-name = "vreg_s3j_1p1";
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1100000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1j_0p91: ldo1 {
			regulator-name = "vreg_l1j_0p91";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <920000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2j_1p2: ldo2 {
			regulator-name = "vreg_l2j_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

&qupv3_2 {
	status = "okay";
};

&i2c3 {
	status = "okay";

	/* USB subsystem of the WCD939x codec: switches the SBU pins */
	wcd_usbss: typec-mux@e {
		compatible = "qcom,wcd9395-usbss", "qcom,wcd9390-usbss";
		reg = <0xe>;

		vdd-supply = <&vreg_l15b_1p8>;

		mode-switch;
		orientation-switch;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				wcd_usbss_sbu_mux: endpoint {
					remote-endpoint = <&pmic_glink_sbu>;
				};
			};
		};
	};
};

&i2c11 {
	status = "okay";

	/* Second LED string; the stock DT gives it no enable pins and the
	 * stock driver never programs its bias section. */
	ktz8868_slave: backlight@11 {
		compatible = "kinetic,ktz8868";
		reg = <0x11>;

		ktz8868_slave_led: led {
			function = LED_FUNCTION_BACKLIGHT;
			function-enumerator = <2>;
			color = <LED_COLOR_ID_WHITE>;
			led-sources = <0 1 2 4 5>;
		};
	};
};

&i2c_master_hub_0 {
	status = "okay";
};

&i2c_hub_0 {
	status = "okay";

	ktz8868_master: backlight@11 {
		compatible = "kinetic,ktz8868";
		reg = <0x11>;

		enable-gpios = <&tlmm 15 GPIO_ACTIVE_HIGH>;

		kinetic,enable-lcd-bias;

		ktz8868_master_led: led {
			function = LED_FUNCTION_BACKLIGHT;
			function-enumerator = <1>;
			color = <LED_COLOR_ID_WHITE>;
			led-sources = <0 1 2 4 5>;
		};

		lcd_vsn: outn {
			regulator-name = "lcd_vsn";
			enable-gpios = <&tlmm 14 GPIO_ACTIVE_HIGH>;
		};

		lcd_vsp: outp {
			regulator-name = "lcd_vsp";
			enable-gpios = <&tlmm 111 GPIO_ACTIVE_HIGH>;
		};
	};
};

/*
 * CPS8601 inductive pen charger (TX coil for the stylus). Five TLMM lines
 * from the stock dtbo fragment@80: int 172, sleep 106, scan 56,
 * off_state 107, sw_en 105. The chip carries factory firmware; the
 * optional SRAM update image (wireless_pen/0/cps8601_firmware.bin) is
 * not required for first bring-up.
 */
&i2c_hub_3 {
	status = "okay";

	cps8601: pen-charger@41 {
		compatible = "oplus,wls-charger-cps8601";
		reg = <0x41>;

		int-gpios = <&tlmm 172 GPIO_ACTIVE_HIGH>;
		sleep-gpios = <&tlmm 106 GPIO_ACTIVE_HIGH>;
		scan-gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
		boost-en-gpios = <&tlmm 107 GPIO_ACTIVE_HIGH>;
		sw-en-gpios = <&tlmm 105 GPIO_ACTIVE_HIGH>;

		oplus,ocp-threshold = <500>;
		oplus,ovp-threshold = <12000>;
		oplus,lvp-threshold = <4000>;
		oplus,fod-threshold = <400>;
	};
};

/* ---------------------------------------------------------------------------
 * SuperVOOC fast charging - dual Southchip SC8547A charge pump (master+slave),
 * ported from the 7.3-rc5 erhai tree (TheMojoMan, lab-validated 39 W PPS).
 * Ground truth (live OxygenOS /proc/device-tree + stock dtbo fixups):
 *   master oplus,sc8547a@6F on qupv3_hub_i2c8 == mainline i2c_hub_8 (@9a0000),
 *          addr 0x6F, IRQ tlmm gpio163 (falling), ovp 0x36 ocp 0x0b
 *   slave  sc8547-charger-slave@6F on qupv3_hub_i2c2 == mainline i2c_hub_2
 *          (@988000), addr 0x6F, no IRQ ("oplus,slave").
 * Both are SC8547A 2:1 pumps with an integrated VOOC serial PHY, driven
 * AP-side by drivers/power/supply/sc8547a.c (CONFIG_CHARGER_SC8547A);
 * the PPS host engine is erhai_pps.c (CONFIG_CHARGER_ERHAI_PPS).
 * Stock runs both buses at 400 kHz (dtbo fragment@76 qcom,clk-freq-out);
 * 100 kHz default kept as on the validated 7.3 tree - flip to 400 kHz by
 * adding clock-frequency if the pump trace shows slow I2C.
 */
&i2c_hub_8 {
	status = "okay";

	sc8547a_master: charge-pump@6f {
		compatible = "oplus,sc8547a";
		reg = <0x6f>;

		interrupts-extended = <&tlmm 163 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&sc8547_int_active>;

		sc,vbat-ovp-reg = /bits/ 8 <0x36>;
		sc,ibus-ocp-reg = /bits/ 8 <0x0b>;
	};
};

&i2c_hub_2 {
	status = "okay";

	sc8547a_slave: charge-pump@6f {
		compatible = "oplus,sc8547a";
		reg = <0x6f>;
		oplus,slave;

		sc,vbat-ovp-reg = /bits/ 8 <0x36>;
		sc,ibus-ocp-reg = /bits/ 8 <0x0b>;
	};
};

&i2c_hub_4 {
	clock-frequency = <400000>;
	status = "okay";

	spk_amp3: audio-codec@34 {
		compatible = "awinic,aw88261";
		reg = <0x34>;
		#sound-dai-cells = <0>;
		dvdd-supply = <&spk_amp_dvdd>;
		firmware-name = "awinic/erhai/aw88261_acf.bin";
		sound-name-prefix = "Amp3";
		awinic,audio-channel = <3>;
	};

	spk_amp1: audio-codec@35 {
		compatible = "awinic,aw88261";
		reg = <0x35>;
		#sound-dai-cells = <0>;
		dvdd-supply = <&spk_amp_dvdd>;
		firmware-name = "awinic/erhai/aw88261_acf.bin";
		sound-name-prefix = "Amp1";
		awinic,audio-channel = <1>;
	};

	spk_amp5: audio-codec@36 {
		compatible = "awinic,aw88261";
		reg = <0x36>;
		#sound-dai-cells = <0>;
		dvdd-supply = <&spk_amp_dvdd>;
		firmware-name = "awinic/erhai/aw88261_acf.bin";
		sound-name-prefix = "Amp5";
		awinic,audio-channel = <5>;
	};
};

&i2c_hub_9 {
	clock-frequency = <400000>;
	status = "okay";

	spk_amp0: audio-codec@34 {
		compatible = "awinic,aw88261";
		reg = <0x34>;
		#sound-dai-cells = <0>;
		dvdd-supply = <&spk_amp_dvdd>;
		firmware-name = "awinic/erhai/aw88261_acf.bin";
		sound-name-prefix = "Amp0";
		awinic,audio-channel = <0>;
	};

	spk_amp2: audio-codec@35 {
		compatible = "awinic,aw88261";
		reg = <0x35>;
		#sound-dai-cells = <0>;
		dvdd-supply = <&spk_amp_dvdd>;
		firmware-name = "awinic/erhai/aw88261_acf.bin";
		sound-name-prefix = "Amp2";
		awinic,audio-channel = <2>;
	};

	spk_amp6: audio-codec@36 {
		compatible = "awinic,aw88261";
		reg = <0x36>;
		#sound-dai-cells = <0>;
		dvdd-supply = <&spk_amp_dvdd>;
		firmware-name = "awinic/erhai/aw88261_acf.bin";
		sound-name-prefix = "Amp6";
		awinic,audio-channel = <6>;
	};
};

&iris {
	firmware-name = "qcom/sm8750/erhai/vpu35_4v.mbn";

	status = "okay";
};

&mdss {
	status = "okay";
};

&mdss_dp0 {
	status = "okay";
};

&mdss_dp0_out {
	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000 8100000000>;
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l3g_1p2>;

	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;
	qcom,master-dsi;

	status = "okay";

	panel: panel@0 {
		compatible = "novatek,nt36536";
		reg = <0>;

		reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;

		/* The panel drives TE on gpio86 (mdp_vsync); the DPU video engine
		 * syncs to it by default (DPU_VSYNC_SOURCE_GPIO_0). Without it
		 * no frame ever completes (vblank timeouts, black screen). */
		pinctrl-0 = <&mdp_te_vsync>;
		pinctrl-names = "default";
		vddio-supply = <&vreg_l12b_1p8>;
		vsn-supply = <&lcd_vsn>;
		vsp-supply = <&lcd_vsp>;

		backlight = <&panel_backlight>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				panel0_in: endpoint {
					remote-endpoint = <&mdss_dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;

				panel1_in: endpoint {
					remote-endpoint = <&mdss_dsi1_out>;
				};
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l3i_0p88>;

	status = "okay";
};

&mdss_dsi1 {
	vdda-supply = <&vreg_l3g_1p2>;

	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;

	/* DSI1 is the slave link; use DSI0's PLL clocks */
	clocks = <&dispcc DISP_CC_MDSS_BYTE1_CLK>,
		 <&dispcc DISP_CC_MDSS_BYTE1_INTF_CLK>,
		 <&dispcc DISP_CC_MDSS_PCLK1_CLK>,
		 <&dispcc DISP_CC_MDSS_ESC1_CLK>,
		 <&dispcc DISP_CC_MDSS_AHB_CLK>,
		 <&gcc GCC_DISP_HF_AXI_CLK>,
		 <&mdss_dsi0_phy DSI_PIXEL_PLL_CLK>,
		 <&mdss_dsi0_phy DSI_BYTE_PLL_CLK>,
		 <&dispcc DISP_CC_ESYNC1_CLK>,
		 <&dispcc DISP_CC_OSC_CLK>,
		 <&dispcc DISP_CC_MDSS_BYTE1_CLK_SRC>,
		 <&dispcc DISP_CC_MDSS_PCLK1_CLK_SRC>;

	status = "okay";
};

&mdss_dsi1_out {
	remote-endpoint = <&panel1_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi1_phy {
	vdds-supply = <&vreg_l3i_0p88>;

	status = "okay";
};

&gpi_dma1 {
	status = "okay";
};

&pm8550_gpios {
	volume_down_n: volume-down-n-state {
		pins = "gpio6";
		function = "normal";
		bias-pull-up;
		input-enable;
		power-source = <1>;
	};
};

&pm8550_temp_alarm {
	io-channels = <&pmk8550_adc 0x103>;
	io-channel-names = "thermal";
};

&pmih0108_eusb2_repeater {
	qcom,tune-usb2-preem = /bits/ 8 <0x3>;
	qcom,tune-usb2-amplitude = /bits/ 8 <0xb>;
	qcom,tune-usb2-disc-thres = /bits/ 8 <0x7>;
	qcom,squelch-detector-bp = <(-2000)>;

	vdd18-supply = <&vreg_l15b_1p8>;
	vdd3-supply = <&vreg_l5b_3p1>;

	status = "okay";
};

&pmk8550 {
	pmk8550_adc: adc@9000 {
		compatible = "qcom,spmi-adc5-gen3";
		reg = <0x9000>, <0x9100>;
		interrupts = <0x0 0x90 0x1 IRQ_TYPE_EDGE_RISING>,
			     <0x0 0x91 0x1 IRQ_TYPE_EDGE_RISING>;
		#address-cells = <1>;
		#size-cells = <0>;
		#io-channel-cells = <1>;
		#thermal-sensor-cells = <1>;

		channel@3 {
			reg = <0x3>;
			label = "pmk8550-die";
			qcom,pre-scaling = <1 1>;
		};

		channel@44 {
			reg = <0x44>;
			label = "xo-therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
			qcom,adc-tm;
		};

		channel@103 {
			reg = <0x103>;
			label = "pm8550-die";
			qcom,pre-scaling = <1 1>;
		};

		channel@144 {
			reg = <0x144>;
			label = "skin-therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
			qcom,adc-tm;
		};

		channel@149 {
			reg = <0x149>;
			label = "gpio2-therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
			qcom,adc-tm;
		};
	};
};

&pmk8550_rtc {
	nvmem-cells = <&rtc_offset>;
	nvmem-cell-names = "offset";
};

&pmk8550_sdam_2 {
	rtc_offset: rtc-offset@bc {
		reg = <0xbc 0x4>;
	};
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEUP>;
	status = "okay";
};

&q6apmbedai {
	#address-cells = <1>;
	#size-cells = <0>;

	dai@28 {
		reg = <SECONDARY_TDM_RX_0>;
		clocks = <&q6prmcc LPASS_CLK_ID_SEC_TDM_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
		clock-names = "bclk";
	};
};

&qupv3_1 {
	status = "okay";
};

&adspslpi_mem {
	/*
	 * The stock ADSP firmware spans 80.5M from the 0x9ee00000 bank base
	 * (stock adspslpi is 0x5080000); the upstream 58.5M window makes the
	 * mdt loader reject the image as "segment outside memory range".
	 */
	reg = <0x0 0x9ee00000 0x0 0x5080000>;
};

&remoteproc_adsp {
	firmware-name = "qcom/sm8750/erhai/adsp.mdt",
			"qcom/sm8750/erhai/adsp_dtb.mdt";

	status = "okay";
};

&spi4 {
	status = "okay";

	pinctrl-0 = <&qupv3_se4_spi>;
	pinctrl-names = "default";

	touchscreen@0 {
		compatible = "novatek,nt36536-ts";
		reg = <0>;
		spi-max-frequency = <12000000>;

		pinctrl-0 = <&nt36536_int>;
		pinctrl-names = "default";

		interrupt-parent = <&tlmm>;
		interrupts = <162 IRQ_TYPE_EDGE_FALLING>;

		panel = <&panel>;

		/*
		 * The controller reports in its 2400x3392 portrait frame and
		 * the panel scans landscape. The controller's X axis is
		 * mirrored first and the axes are then swapped (the generic
		 * properties invert before they swap). Measured with the USB
		 * port on the right: left to right raises X, top to bottom
		 * raises Y.
		 */
		touchscreen-size-x = <2400>;
		touchscreen-size-y = <3392>;
		/* the 193 x 274 mm active area, along the controller axes */
		touchscreen-x-mm = <193>;
		touchscreen-y-mm = <274>;
		touchscreen-swapped-x-y;
		touchscreen-inverted-x;
		firmware-name = "novatek/nt36536-xn242.bin";
		novatek,pen-support;
	};
};

&swr1 {
	status = "okay";

	wcd_rx: codec@0,4 {
		compatible = "sdw20217010e00";
		reg = <0 4>;
		qcom,rx-port-mapping = <1 2 3 4 5 9>;
	};
};

&swr2 {
	status = "okay";

	/*
	 * The TX soundwire controller reports one DOUT port, but the SoC
	 * baseline declares none. With dout-ports = <0> the driver clears
	 * the count, the WCD9395 TX codec cannot open its control port and
	 * every capture start times out at the ADSP (APM port 120, -110).
	 * Mirror the hamoa (X Elite) TX bus: one DOUT port first, then the
	 * four stock DIN entries.
	 */
	qcom,dout-ports = <1>;
	qcom,ports-sinterval-low =	/bits/ 8 <0x00 0x01 0x01 0x03 0x03>;
	qcom,ports-offset1 =		/bits/ 8 <0x00 0x00 0x00 0x01 0x01>;
	qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x00 0x00 0x00>;
	qcom,ports-hstart =		/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
	qcom,ports-hstop =		/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
	qcom,ports-word-length =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
	qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
	qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
	qcom,ports-lane-control =	/bits/ 8 <0xff 0x01 0x02 0x00 0x00>;

	wcd_tx: codec@0,3 {
		compatible = "sdw20217010e00";
		reg = <0 3>;
		qcom,tx-port-mapping = <2 2 3 4>;
	};
};

&tlmm {
	/* reserved for secure world */
	gpio-reserved-ranges = <36 4>, <74 1>;

	sc8547_int_active: sc8547-int-active-state {
		pins = "gpio163";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		input-enable;
	};

	qupv3_se4_spi: qupv3-se4-spi-state {
		miso-pins {
			pins = "gpio48";
			function = "qup1_se4";
			drive-strength = <6>;
			bias-disable;
		};

		mosi-pins {
			pins = "gpio49";
			function = "qup1_se4";
			drive-strength = <4>;
			bias-disable;
		};

		clk-pins {
			pins = "gpio50";
			function = "qup1_se4";
			drive-strength = <6>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio51";
			function = "qup1_se4";
			drive-strength = <4>;
			bias-disable;
		};
	};

	nt36536_int: nt36536-int-state {
		pins = "gpio162";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};
	wlan_en: wlan-en-state {
		pins = "gpio16";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};
	mdp_te_vsync: mdp-te-vsync-state {
		pins = "gpio86";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	wcd_reset_default: wcd-reset-default-state {
		pins = "gpio101";
		function = "gpio";
		drive-strength = <6>;
		bias-disable;
	};

	sec_tdm_active: sec-tdm-active-state {
		sck-pins {
			pins = "gpio121";
			function = "i2s1_sck";
			drive-strength = <6>;
			bias-disable;
		};

		data0-pins {
			pins = "gpio122";
			function = "i2s1_data0";
			drive-strength = <6>;
			bias-disable;
		};

		ws-pins {
			pins = "gpio123";
			function = "i2s1_ws";
			drive-strength = <6>;
			bias-disable;
		};

		data1-pins {
			pins = "gpio124";
			function = "i2s1_data1";
			drive-strength = <6>;
			bias-pull-down;
		};
	};

	pogo_kb_detect: pogo-kb-detect-state {
		pins = "gpio96";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	/*
	 * The keyboard data line is shared by TX and RX through a direction
	 * switch, so neither pin gets a pull. With the port closed, TX is left
	 * as a floating GPIO like on the stock firmware.
	 */
	pogo_kb_uart_default: pogo-kb-uart-default-state {
		tx-pins {
			pins = "gpio2";
			function = "qup2_se0";
			drive-strength = <8>;
			bias-disable;
		};

		rx-pins {
			pins = "gpio3";
			function = "qup2_se0";
			drive-strength = <2>;
			bias-disable;
		};
	};

	pogo_kb_uart_sleep: pogo-kb-uart-sleep-state {
		tx-pins {
			pins = "gpio2";
			function = "gpio";
			drive-strength = <8>;
			bias-disable;
		};

		rx-pins {
			pins = "gpio3";
			function = "qup2_se0";
			drive-strength = <2>;
			bias-disable;
		};
	};
};

&uart7 {
	status = "okay";
};

&ufs_mem_hc {
	reset-gpios = <&tlmm 215 GPIO_ACTIVE_LOW>;

	vcc-supply = <&vreg_l17b_2p5>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l1d_1p2>;
	vccq-max-microamp = <1200000>;

	status = "okay";
};

&pcie0 {
	pinctrl-0 = <&pcie0_default_state>;
	pinctrl-names = "default";

	status = "okay";
};

&pcie0_phy {
	vdda-phy-supply = <&vreg_l1f_0p88>;
	vdda-pll-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&pcieport0 {
	wake-gpios = <&tlmm 104 GPIO_ACTIVE_HIGH>;
	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;

	wifi@0 {
		compatible = "pci17cb,110e";
		reg = <0x10000 0x0 0x0 0x0 0x0>;

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
	};
};

&gpu {
	status = "okay";
};

&gpu_zap_shader {
	firmware-name = "qcom/sm8750/erhai/gen80000_zap.mbn";
};

&uart_kb {
	pinctrl-0 = <&pogo_kb_uart_default>;
	pinctrl-1 = <&pogo_kb_uart_sleep>;
	pinctrl-names = "default", "sleep";

	status = "okay";

	keyboard {
		compatible = "oneplus,pad2pro-pogo-keyboard";

		vdd-supply = <&pogo_kb_pwr>;
		tx-enable-gpios = <&tlmm 83 GPIO_ACTIVE_HIGH>;
		detect-gpios = <&tlmm 96 GPIO_ACTIVE_LOW>;
		interrupts-extended = <&tlmm 96 IRQ_TYPE_EDGE_FALLING>;
		current-speed = <921600>;
		wakeup-source;

		pinctrl-0 = <&pogo_kb_detect>;
		pinctrl-names = "default";
	};
};

&uart14 {
	pinctrl-0 = <&qup_uart14_default>, <&qup_uart14_cts_rts>;
	pinctrl-names = "default";

	status = "okay";

	bluetooth {
		compatible = "qcom,wcn7860-bt";

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;

		max-speed = <3200000>;
	};
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1j_0p91>;
	vdda-pll-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&usb {
	/* role follows the pmic-glink Type-C notifications now that ADSP runs */
	status = "okay";
};

&usb_dp_qmpphy {
	vdda-phy-supply = <&vreg_l3g_1p2>;
	vdda-pll-supply = <&vreg_l2d_0p88>;

	status = "okay";
};

&usb_dp_qmpphy_out {
	remote-endpoint = <&pmic_glink_ss_in>;
};

&usb_dwc3_hs {
	remote-endpoint = <&pmic_glink_hs_in>;
};

&usb_hsphy {
	vdd-supply = <&vreg_l2d_0p88>;
	vdda12-supply = <&vreg_l3g_1p2>;

	phys = <&pmih0108_eusb2_repeater>;

	status = "okay";
};

&pm8550ve_f_gpios {
	bt_default: bt-default-state {
		pins = "gpio3";
		function = "normal";
		power-source = <1>;
		bias-disable;
		input-disable;
		output-enable;
	};
};


/*
 * Camera stage-0 bring-up: PM8550 flash/torch and the rear CCI0 bus.
 * Both are independent of CAMSS; the flash lights up via sysfs as soon
 * as leds-qcom-flash binds, and CCI0 registers an i2c adapter so the
 * rear sensor/EEPROM addresses can be probed with i2cdetect.
 */
/*
 * sid-8 PM8550VE that carries the rear camera reset gpio (no mainline
 * dtsi instantiates it; upstream sm8750-pmics only covers sid 5 = _f).
 */
&spmi_bus {
	pm8550ve_i: pmic@8 {
		compatible = "qcom,pm8550ve", "qcom,spmi-pmic";
		reg = <0x8 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pm8550ve_i_gpios: gpio@8800 {
			compatible = "qcom,pm8550ve-gpio", "qcom,spmi-gpio";
			reg = <0x8800>;
			gpio-controller;
			gpio-ranges = <&pm8550ve_i_gpios 0 0 8>;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};

&pm8550 {
	flash-led@ee00 {
		compatible = "qcom,pm8550-flash-led", "qcom,spmi-flash-led";
		reg = <0xee00>;

		/* bring-up: all four channels exposed separately so the wired
		 * ones can be found at runtime; collapse once identified */
		led-0 {
			function = LED_FUNCTION_FLASH;
			color = <LED_COLOR_ID_WHITE>;
			function-enumerator = <1>;
			led-sources = <1>;
			led-max-microamp = <500000>;
			flash-max-microamp = <1500000>;
			flash-max-timeout-us = <1280000>;
		};

		led-1 {
			function = LED_FUNCTION_FLASH;
			color = <LED_COLOR_ID_WHITE>;
			function-enumerator = <2>;
			led-sources = <2>;
			led-max-microamp = <500000>;
			flash-max-microamp = <1500000>;
			flash-max-timeout-us = <1280000>;
		};

		led-2 {
			function = LED_FUNCTION_FLASH;
			color = <LED_COLOR_ID_WHITE>;
			function-enumerator = <3>;
			led-sources = <3>;
			led-max-microamp = <500000>;
			flash-max-microamp = <1500000>;
			flash-max-timeout-us = <1280000>;
		};

		led-3 {
			function = LED_FUNCTION_FLASH;
			color = <LED_COLOR_ID_WHITE>;
			function-enumerator = <4>;
			led-sources = <4>;
			led-max-microamp = <500000>;
			flash-max-microamp = <1500000>;
			flash-max-timeout-us = <1280000>;
		};
	};
};

&tlmm {
	cam_rear_mclk_default: cam-rear-mclk-default-state {
		pins = "gpio90";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};

	/*
	 * CCI0 master 1 pins (rear camera + VCM).  Pull-up is mandatory:
	 * bias-disable left SDA floating, and when cci_init() arms the full
	 * IRQ error mask CCI flags a bus error on the floating line ->
	 * HALT_REQ -> RESET -> RST_DONE storm = uninterruptible IRQ
	 * livelock (TheMojoMan's Pad 3 finding).  The same state doubles as
	 * sleep: it idles the bus high.
	 */
	cci0_i2c_sda1_default: cci0-i2c-sda1-default-state {
		pins = "gpio115";
		function = "cci_i2c_sda";
		drive-strength = <2>;
		bias-pull-up;
	};

	cci0_i2c_scl1_default: cci0-i2c-scl1-default-state {
		pins = "gpio116";
		function = "cci_i2c_scl";
		drive-strength = <2>;
		bias-pull-up;
	};
};

&soc {
	/*
	 * CCI0 — rear camera I2C (SC1320CS @0x36 + CN3927 VCM @0x0c on
	 * master 1).  Node values are TheMojoMan's v491..v495 recipe,
	 * verified on his Pad 3 (same panel of hardware): CPAS-TOP window,
	 * the 10-clock set, the AHB/cam_hf/cam_sf interconnect votes and the
	 * ICP-0 CAMNOC runtime rates.
	 *
	 * The erhai port of i2c-qcom-cci is now in the tree: it takes the
	 * CPAS-TOP window and the AHB/cam_hf/cam_sf votes this node declares,
	 * and gates the CSR write in probe behind erhai_cci_csr (default 0,
	 * boot-safe).  See the status comment inside the node.
	 */
	cci0: cci@ac7b000 {
		compatible = "qcom,sm8750-cci", "qcom,msm8996-cci";
		/* reg[0] = CCI CSR; reg[1] = CPAS-TOP (qchannel wakeup).
		 * NB cam_cpas_top MMIO is at ac04000, not ac13000. */
		reg = <0 0x0ac7b000 0 0x1000>,
		      <0 0x0ac04000 0 0x1000>;
		reg-names = "cci", "cpas_top";
		interrupts = <GIC_SPI 426 IRQ_TYPE_EDGE_RISING>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;

		/* ahb opens the CPU->camera-cfg NoC path to the CSR;
		 * cam_hf/cam_sf fire the RPMh CAMNOC BCM out of retention. */
		interconnects = <&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
				 &config_noc SLAVE_CAMERA_CFG QCOM_ICC_TAG_ACTIVE_ONLY>,
				<&mmss_noc MASTER_CAMNOC_HF QCOM_ICC_TAG_ALWAYS
				 &mmss_noc SLAVE_MNOC_HF_MEM_NOC QCOM_ICC_TAG_ALWAYS>,
				<&mmss_noc MASTER_CAMNOC_SF QCOM_ICC_TAG_ALWAYS
				 &mmss_noc SLAVE_MNOC_SF_MEM_NOC QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "ahb", "cam_hf", "cam_sf";

		clocks = <&camcc CAM_CC_CAMNOC_NRT_AXI_CLK>,
			 <&camcc CAM_CC_CAM_TOP_AHB_CLK>,
			 <&camcc CAM_CC_CORE_AHB_CLK>,
			 <&camcc CAM_CC_CCI_0_CLK>,
			 <&camcc CAM_CC_ICP_0_AHB_CLK>,
			 <&camcc CAM_CC_ICP_0_CLK>,
			 <&camcc CAM_CC_CAMNOC_RT_AXI_CLK>,
			 <&gcc GCC_CAMERA_AHB_CLK>,
			 <&gcc GCC_CAMERA_HF_AXI_CLK>,
			 <&gcc GCC_CAMERA_SF_AXI_CLK>;
		clock-names = "camnoc_axi", "cpas_ahb", "cpas_core_ahb", "cci",
			      "icp_ahb", "icp", "camnoc_rt",
			      "gcc_cam_ahb", "gcc_cam_hf_axi", "gcc_cam_sf_axi";
		assigned-clocks = <&camcc CAM_CC_CCI_0_CLK_SRC>,
				  <&camcc CAM_CC_ICP_0_CLK_SRC>,
				  <&camcc CAM_CC_CAMNOC_RT_AXI_CLK_SRC>;
		assigned-clock-rates = <37500000>,
				       <300000000>,
				       <400000000>;

		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&cci0_i2c_sda1_default &cci0_i2c_scl1_default>;
		pinctrl-1 = <&cci0_i2c_sda1_default &cci0_i2c_scl1_default>;

		#address-cells = <1>;
		#size-cells = <0>;

		/* The sc1320cs/cn3927 drivers are in the tree; enable CCI.
		 * The erhai i2c-qcom-cci port defaults to erhai_cci_csr=0
		 * (boot-safe: clocks+votes only, no CSR bring-up at probe);
		 * erhai-boot-heal rebinds with erhai_cci_csr=1 once the
		 * system is up, where a hang only costs a reboot. */
		status = "okay";

		/*
		 * master[0] MUST exist even though the sensors sit on
		 * master 1: cci_reset() waits on master[0].irq_complete,
		 * which is only initialised for masters with an i2c-bus
		 * child.  An empty bus@0 avoids the OOPS; nothing xfers
		 * on it.
		 */
		cci0_i2c0: i2c-bus@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		cci0_i2c1: i2c-bus@1 {
			reg = <1>;
			/* FAST (400 kHz) is the fastest this bus sustains;
			 * FAST_PLUS never meets VIH.  Downstream default. */
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;

			sc1320cs: camera-sensor@36 {
				compatible = "smartsens,sc1320cs";
				reg = <0x36>;

				clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK1_CLK>;
				clock-names = "cam_clk";
				assigned-clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK1_CLK>;
				assigned-clock-rates = <19200000>;

				pinctrl-names = "default";
				pinctrl-0 = <&cam_rear_mclk_default>;

				/* The MCLK gates live inside TITAN_TOP_GDSC: without the
				 * domain on, the branch is hw-protected and
				 * clk_prepare_enable returns -EBUSY. */
				power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;

				reset-gpios = <&pm8550ve_i_gpios 5 GPIO_ACTIVE_LOW>;

				/* Rear-facing module. */
				orientation = <1>;
				rotation = <0>;

				cam_vana-supply = <&vreg_l16b_2p8>;
				cam_vio-supply  = <&vreg_l4b_1p8>;
				cam_vdig-supply = <&vreg_l1i_1p2>;
				cam_vaf-supply  = <&vreg_l9b_2p9>;

				/* Rear AF voice-coil motor (CCI0-m1 @0x0c). */
				lens-focus = <&vcm>;

				/* MIPI CSI-2 D-PHY 4-lane out -> CAMSS CSIPHY4.
				 * Android CAM_START_PHYDEV for PHY-4:
				 * 1200 Mbps/lane -> DDR link clock 600 MHz. */
				port {
					sc1320cs_ep: endpoint {
						remote-endpoint = <&camss_csiphy4>;
						data-lanes = <0 1 2 3>;
						link-frequencies = /bits/ 64 <600000000>;
					};
				};
			};

			/*
			 * Rear AF VCM, CN3927 protocol (unlock 0xed, DAC
			 * position regs 0x03/0x04), verified via i2ctransfer
			 * on the Pad 3.  The VAF rail is shared with the
			 * sensor; the regulator core refcounts it.
			 */
			vcm: lens@c {
				compatible = "chipnext,cn3927";
				reg = <0x0c>;

				vio-supply = <&vreg_l4b_1p8>;
				vaf-supply = <&vreg_l9b_2p9>;
			};
		};
	};

	/*
	 * CAMSS — full qcom,sm8750-camss binding node.
	 *
	 * Rewritten to the official SM8750 CAMSS DT binding
	 * (Documentation/devicetree/bindings/media/qcom,sm8750-camss.yaml):
	 * 19 reg windows, 35 clocks, 16 IRQs, 4 interconnect paths and the
	 * 4-GDSC power-domain set (ife0/ife1/ife2/top).  Bases, IRQs and clock
	 * names are cross-checked against the live Android DT (dtbo fragment@91):
	 *   csid0/1/2     ad27000/ad2a000/ad2d000 (0x2b00)   irq 601/603/431
	 *   csid_lite0/1  ad6d000/ad72000 (0xa00)            irq 605/376
	 *   csiphy0-5     ada9000..adb3000 (0x2000)          irq 477/478/479/448/122/89
	 *   csitpg0-2     ad8b000/ad8c000/ad8d000 (0x400)
	 *   vfe0/1/2      ac86000/ac96000/aca6000 (0x10000)  irq 433/436/457
	 *   vfe_lite0/1   ad6e000/ad73000 (0x3000)           irq 606/377
	 *
	 * The vfe_lite windows come from the official binding example, not the
	 * vendor dtbo: the vendor layout (ad6d000/ad72000, 0x2800) overlaps the
	 * csid_lite windows (0xa00), and the mainline driver
	 * devm_request_mem_region()s each subdev window independently, so an
	 * overlap fails with -EBUSY.  Independent windows are the working
	 * arrangement; do not "restore" the downstream addresses.
	 *
	 * The in-tree driver (csiphy_res_8750/csid_res_8750/icc_res_sm8750,
	 * official v5 patch set) only instantiates CSIPHY + CSID entities and
	 * consumes the "top" power domain plus the "ahb"/"hf_mnoc" ICC paths;
	 * the remaining windows/clocks/PDs satisfy the binding and sit ready
	 * for the full TFE driver.
	 *
	 * CSIPHY analog rails follow the vendor wiring (dtbo regulator symbols:
	 * 0p9 = L1F on phy0/1/3/5 / L3I on phy2/4, 1p2 = L3G on all six).
	 *
	 * SMMU SID 0x1c00 from the live Android DT (cam_smmu_ife context
	 * bank, mask 0x0 as Android has it).  Without it VIDIOC_REQBUFS
	 * falls back to swiotlb and a 16 MB RAW frame never fits.
	 */
	camss: isp@ad27000 {
		compatible = "qcom,sm8750-camss";

		reg = <0 0x0ad27000 0 0x2b00>,
		      <0 0x0ad2a000 0 0x2b00>,
		      <0 0x0ad2d000 0 0x2b00>,
		      <0 0x0ad6d000 0 0xa00>,
		      <0 0x0ad72000 0 0xa00>,
		      <0 0x0ada9000 0 0x2000>,
		      <0 0x0adab000 0 0x2000>,
		      <0 0x0adad000 0 0x2000>,
		      <0 0x0adaf000 0 0x2000>,
		      <0 0x0adb1000 0 0x2000>,
		      <0 0x0adb3000 0 0x2000>,
		      <0 0x0ad8b000 0 0x400>,
		      <0 0x0ad8c000 0 0x400>,
		      <0 0x0ad8d000 0 0x400>,
		      <0 0x0ac86000 0 0x10000>,
		      <0 0x0ac96000 0 0x10000>,
		      <0 0x0aca6000 0 0x10000>,
		      <0 0x0ad6e000 0 0x3000>,
		      <0 0x0ad73000 0 0x3000>;
		reg-names = "csid0",
		            "csid1",
		            "csid2",
		            "csid_lite0",
		            "csid_lite1",
		            "csiphy0",
		            "csiphy1",
		            "csiphy2",
		            "csiphy3",
		            "csiphy4",
		            "csiphy5",
		            "csitpg0",
		            "csitpg1",
		            "csitpg2",
		            "vfe0",
		            "vfe1",
		            "vfe2",
		            "vfe_lite0",
		            "vfe_lite1";

		clocks = <&camcc CAM_CC_CAMNOC_NRT_AXI_CLK>,
		         <&camcc CAM_CC_CAMNOC_RT_AXI_CLK>,
		         <&camcc CAM_CC_CAM_TOP_AHB_CLK>,
		         <&camcc CAM_CC_CAM_TOP_FAST_AHB_CLK>,
		         <&camcc CAM_CC_CAMNOC_RT_TFE_0_MAIN_CLK>,
		         <&camcc CAM_CC_CAMNOC_RT_TFE_1_MAIN_CLK>,
		         <&camcc CAM_CC_CAMNOC_RT_TFE_2_MAIN_CLK>,
		         <&camcc CAM_CC_CAMNOC_RT_IFE_LITE_CLK>,
		         <&camcc CAM_CC_CSID_CLK>,
		         <&camcc CAM_CC_CSID_CSIPHY_RX_CLK>,
		         <&camcc CAM_CC_CSIPHY0_CLK>,
		         <&camcc CAM_CC_CSI0PHYTIMER_CLK>,
		         <&camcc CAM_CC_CSIPHY1_CLK>,
		         <&camcc CAM_CC_CSI1PHYTIMER_CLK>,
		         <&camcc CAM_CC_CSIPHY2_CLK>,
		         <&camcc CAM_CC_CSI2PHYTIMER_CLK>,
		         <&camcc CAM_CC_CSIPHY3_CLK>,
		         <&camcc CAM_CC_CSI3PHYTIMER_CLK>,
		         <&camcc CAM_CC_CSIPHY4_CLK>,
		         <&camcc CAM_CC_CSI4PHYTIMER_CLK>,
		         <&camcc CAM_CC_CSIPHY5_CLK>,
		         <&camcc CAM_CC_CSI5PHYTIMER_CLK>,
		         <&gcc GCC_CAMERA_HF_AXI_CLK>,
		         <&gcc GCC_CAMERA_SF_AXI_CLK>,
		         <&camcc CAM_CC_TFE_0_MAIN_CLK>,
		         <&camcc CAM_CC_TFE_0_MAIN_FAST_AHB_CLK>,
		         <&camcc CAM_CC_TFE_1_MAIN_CLK>,
		         <&camcc CAM_CC_TFE_1_MAIN_FAST_AHB_CLK>,
		         <&camcc CAM_CC_TFE_2_MAIN_CLK>,
		         <&camcc CAM_CC_TFE_2_MAIN_FAST_AHB_CLK>,
		         <&camcc CAM_CC_IFE_LITE_CLK>,
		         <&camcc CAM_CC_IFE_LITE_AHB_CLK>,
		         <&camcc CAM_CC_IFE_LITE_CPHY_RX_CLK>,
		         <&camcc CAM_CC_IFE_LITE_CSID_CLK>,
		         <&camcc CAM_CC_QDSS_DEBUG_XO_CLK>;
		clock-names = "camnoc_nrt_axi",
		              "camnoc_rt_axi",
		              "cpas_ahb",
		              "cpas_fast_ahb",
		              "cpas_vfe0",
		              "cpas_vfe1",
		              "cpas_vfe2",
		              "cpas_vfe_lite",
		              "csid",
		              "csid_csiphy_rx",
		              "csiphy0",
		              "csiphy0_timer",
		              "csiphy1",
		              "csiphy1_timer",
		              "csiphy2",
		              "csiphy2_timer",
		              "csiphy3",
		              "csiphy3_timer",
		              "csiphy4",
		              "csiphy4_timer",
		              "csiphy5",
		              "csiphy5_timer",
		              "gcc_axi_hf",
		              "gcc_axi_sf",
		              "vfe0",
		              "vfe0_fast_ahb",
		              "vfe1",
		              "vfe1_fast_ahb",
		              "vfe2",
		              "vfe2_fast_ahb",
		              "vfe_lite",
		              "vfe_lite_ahb",
		              "vfe_lite_cphy_rx",
		              "vfe_lite_csid",
		              "qdss_debug_xo";

		interrupts = <GIC_SPI 601 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 603 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 431 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 605 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 376 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 477 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 478 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 479 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 448 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 122 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 89 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 433 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 436 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 457 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 606 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 377 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "csid0",
		                  "csid1",
		                  "csid2",
		                  "csid_lite0",
		                  "csid_lite1",
		                  "csiphy0",
		                  "csiphy1",
		                  "csiphy2",
		                  "csiphy3",
		                  "csiphy4",
		                  "csiphy5",
		                  "vfe0",
		                  "vfe1",
		                  "vfe2",
		                  "vfe_lite0",
		                  "vfe_lite1";

		interconnects = <&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
				 &config_noc SLAVE_CAMERA_CFG QCOM_ICC_TAG_ACTIVE_ONLY>,
				<&mmss_noc MASTER_CAMNOC_HF QCOM_ICC_TAG_ALWAYS
				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
				<&mmss_noc MASTER_CAMNOC_SF QCOM_ICC_TAG_ALWAYS
				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
				<&mmss_noc MASTER_CAMNOC_NRT_ICP_SF QCOM_ICC_TAG_ALWAYS
				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "ahb", "hf_mnoc",
				      "sf_mnoc", "sf_icp_mnoc";

		iommus = <&apps_smmu 0x1c00 0x0>;
		dma-coherent;

		power-domains = <&camcc CAM_CC_TFE_0_GDSC>,
		                <&camcc CAM_CC_TFE_1_GDSC>,
		                <&camcc CAM_CC_TFE_2_GDSC>,
		                <&camcc CAM_CC_TITAN_TOP_GDSC>;
		power-domain-names = "ife0",
		                     "ife1",
		                     "ife2",
		                     "top";

		vdd-csiphy0-0p9-supply = <&vreg_l1f_0p88>;
		vdd-csiphy1-0p9-supply = <&vreg_l1f_0p88>;
		vdd-csiphy2-0p9-supply = <&vreg_l3i_0p88>;
		vdd-csiphy3-0p9-supply = <&vreg_l1f_0p88>;
		vdd-csiphy4-0p9-supply = <&vreg_l3i_0p88>;
		vdd-csiphy5-0p9-supply = <&vreg_l1f_0p88>;
		vdd-csiphy0-1p2-supply = <&vreg_l3g_1p2>;
		vdd-csiphy1-1p2-supply = <&vreg_l3g_1p2>;
		vdd-csiphy2-1p2-supply = <&vreg_l3g_1p2>;
		vdd-csiphy3-1p2-supply = <&vreg_l3g_1p2>;
		vdd-csiphy4-1p2-supply = <&vreg_l3g_1p2>;
		vdd-csiphy5-1p2-supply = <&vreg_l3g_1p2>;

		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/* Rear SC1320CS; the sc1320cs/cn3927 drivers are in
			 * the tree now, so the remote completes the async
			 * notifier (it sat parked until then — a never-arriving
			 * remote blocked .complete for every camera). */
			port@4 {
				reg = <4>;

				camss_csiphy4: endpoint {
					remote-endpoint = <&sc1320cs_ep>;
					data-lanes = <0 1 2 3>;
				};
			};

			port@5 {
				reg = <5>;

				camss_csiphy5: endpoint {
					remote-endpoint = <&sc820cs_out>;
					data-lanes = <0 1 2 3>;
				};
			};
		};
	};
};

/*
 * Camera stage-1 bring-up: front sensor SmartSens SC820CS on the plain
 * QUP2 SE1 I2C bus (not CCI - the vendor tree wires the front camera to
 * qupv3_se9_i2c, gpio4 SDA / gpio5 SCL, which is mainline i2c9).
 *
 * Hardware facts from the vendor erhai_camera_overlay_common_evb.dtsi
 * (extracted in ~/erhai-pen/sc820cs-notes.md):
 *   RESET4 = tlmm gpio7, MCLK4 = tlmm gpio93 @ 19.2 MHz
 *   (cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK; the 19.2 MHz tap exists in
 *   its freq table straight off bi_tcxo_div2: xo 76.8M -> rpmhcc div2
 *   38.4M -> dtsi div2 19.2M).
 * Regulator mapping from the vendor DT (also recorded in the driver
 * header comment, drivers/media/i2c/sc820cs.c):
 *   DOVDD 1.8 V = L4B, AVDD 2.8 V = L16B, DVDD 1.2 V = L11B.
 *
 * reset-gpios is ACTIVE_LOW because the sensor reset input is active-low
 * and the driver uses proper gpiod logical semantics (set_value(1)
 * asserts, set_value(0) releases; consumer.rst active_low_semantics).
 * Never describe this line with raw physical levels again - reasoning in
 * physical levels is exactly what inverted the sequence twice.
 *
 * Bring-up TODOs:
 *   - CSI hookup DONE (below): sc820cs_out -> camss_csiphy5, values from
 *     TheMojoMan's verified Pad 3 tree.  The camss and cci0 nodes are
 *     enabled; erhai-boot-heal arms the CCI CSR after boot.
 */
&gpi_dma2 {
	status = "okay";
};

&tlmm {
	cam_mclk4_default: cam-mclk4-default-state {
		pins = "gpio93";
		function = "cam_aon_mclk4";
		drive-strength = <2>;
		bias-disable;
	};
};

&i2c9 {
	status = "okay";

	/* 7-bit address.  The vendor dtbo's 0x20 is the 8-bit WRITE address
	 * form; the sensor only ACKs its 7-bit address 0x10 on Linux (same
	 * finding as TheMojoMan's verified Pad 3 tree). */
	front_cam: camera-sensor@10 {
		compatible = "smartsens,sc820cs";
		reg = <0x10>;

		/*
		 * The sensor's 0x00 state already streams upright (verified
		 * with the ceiling-lamp centroid + the register sweep that
		 * decoded 0x3221 bit5=V-flip, bit2=H-mirror).  GNOME Snapshot
		 * still shows it upside-down because it applies the customary
		 * 180° correction to any camera declared FRONT (front modules
		 * are usually mounted inverted).  Declare the camera EXTERNAL
		 * so no front-facing correction is applied and the upright
		 * frame passes through untouched.
		 */
		orientation = <2>;
		rotation = <0>;

		reset-gpios = <&tlmm 7 GPIO_ACTIVE_LOW>;

		dovdd-supply = <&vreg_l4b_1p8>;
		avdd-supply = <&vreg_l16b_2p8>;
		dvdd-supply = <&vreg_l11b_1p0>;

		/*
		 * The MCLK gates in cambistmclkcc (0x1760000) live inside the
		 * CAM_CC_TITAN_TOP_GDSC power domain: the vendor DT feeds this
		 * GDSC to the sensor node as cam_clk-supply.  With the domain
		 * off, the MCLK branch enable bit does not latch and
		 * clk_prepare_enable() fails with -EBUSY.  The i2c core powers
		 * the domain on before calling probe (PD_FLAG_ATTACH_POWER_ON),
		 * and the driver's runtime PM keeps it aligned afterwards.
		 */
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;

		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK>;
		assigned-clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK_SRC>;
		assigned-clock-rates = <19200000>;

		pinctrl-0 = <&cam_mclk4_default>;
		pinctrl-names = "default";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				/* MIPI CSI-2 D-PHY 4-lane out -> CAMSS CSIPHY5.
				 * Link rate ground truth: Android CAM_START_PHYDEV
				 * for PHY-5 on this tablet is 736 Mbps/lane, so the
				 * DDR link clock is 368 MHz (same figure TheMojoMan's
				 * verified Pad 3 tree ships; the earlier 366 MHz was
				 * borrowed from caihong and never verified on erhai).
				 * camss takes the rate from the sensor's
				 * V4L2_CID_LINK_FREQ, keep the two in step. */
				sc820cs_out: endpoint {
					remote-endpoint = <&camss_csiphy5>;
					data-lanes = <0 1 2 3>;
					link-frequencies = /bits/ 64 <368000000>;
				};
			};
		};
	};
};

/* Crash record capture for the intermittent early-boot wedge: the kernel
 * has CONFIG_PSTORE_RAM=y but no region, so forced reboots leave nothing in
 * /sys/fs/pstore.  Park 1 MiB at the top of the last System RAM block
 * (0xbfff00000..0xbffffffff per /proc/iomem); warm resets (panic, watchdog,
 * reboot -f) survive there and cold boots simply start empty. */
/ {
	reserved-memory {
		ramoops@bfff00000 {
			compatible = "ramoops";
			reg = <0xb 0xfff00000 0x0 0x100000>;
			record-size = <0x20000>;
			console-size = <0x40000>;
			ftrace-size = <0x0>;
			pmsg-size = <0x20000>;
			ecc-size = <0x0>;
		};
	};
};
